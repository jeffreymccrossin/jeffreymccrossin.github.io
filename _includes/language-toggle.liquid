{% assign current_lang = page.lang | default: site.lang | downcase %}
{% assign en_url = include.en_url | default: '/' %}
{% assign fr_url = include.fr_url | default: '/fr/' %}
<nav class="language-toggle" aria-label="Language switcher">
  <a class="lang-pill {% if current_lang == 'en' %}active{% endif %}" href="{{ en_url | relative_url }}">EN</a>
  <a class="lang-pill {% if current_lang == 'fr' %}active{% endif %}" href="{{ fr_url | relative_url }}">FR</a>
</nav>
